        <mxCell id="callout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=13" value="Key point: graph traversal and Snowflake retrieval are coordinated after ontology grounding. The LLM receives compact analytical context, not raw transactional rows." vertex="1">
