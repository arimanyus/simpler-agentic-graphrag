        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1" value="How the GraphRAG System Works for One Query" vertex="1">
          <mxGeometry height="40" width="720" x="240" y="30" as="geometry" />
