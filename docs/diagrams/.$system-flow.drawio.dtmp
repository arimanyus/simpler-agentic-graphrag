        <mxCell id="query" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" value="1. User Query&#xa;&quot;Why did APAC retail revenue decline?&quot;" vertex="1">
          <mxGeometry height="85" width="190" x="60" y="140" as="geometry" />
        </mxCell>
        <mxCell id="understand" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" value="2. Query Understanding&#xa;Extract metric, region, business unit, intent" vertex="1">
          <mxGeometry height="85" width="210" x="315" y="140" as="geometry" />
        </mxCell>
        <mxCell id="ground" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" value="3. Ontology Grounding&#xa;Map text mentions to ontology concepts" vertex="1">
          <mxGeometry height="85" width="220" x="590" y="140" as="geometry" />
        </mxCell>
        <mxCell id="expand" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" value="4A. Semantic Expansion&#xa;APAC -&gt; Japan, India, Singapore&#xa;Revenue -&gt; Units, Refunds, Net Revenue" vertex="1">
          <mxGeometry height="110" width="240" x="900" y="250" as="geometry" />
