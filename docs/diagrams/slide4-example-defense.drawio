        <mxCell id="defGraph" value="Why GraphRAG?&#xa;&#xa;Standard RAG retrieves similar chunks. GraphRAG expands retrieval through explicit ontology relationships and hierarchy traversal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10" vertex="1" parent="1">
