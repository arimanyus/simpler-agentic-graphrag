        </mxCell>
        <mxCell id="defTrade" value="Main tradeoff&#xa;&#xa;The ontology must be maintained, versioned, governed, and kept synchronized with the Snowflake schema." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10" vertex="1" parent="1">
