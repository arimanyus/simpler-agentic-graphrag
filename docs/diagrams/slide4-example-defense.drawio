        </mxCell>
        <mxCell id="defSql" value="Why not just SQL?&#xa;&#xa;SQL joins connect tables. The ontology encodes business meaning: hierarchies, metric dependencies, and reasoning relationships." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10" vertex="1" parent="1">
