        </mxCell>

        <mxCell id="footer" value="Snowflake stores truth | the ontology graph stores meaning | the LLM explains grounded evidence -> that is what makes this GraphRAG, not RAG plus a graph database." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
